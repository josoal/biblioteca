{
  "manifest_version": 3,
  "name": "Biblioteca de conocimiento",
  "description": "Guarda enlaces, textos, artículos y capturas en tu biblioteca personal de Notion.",
  "version": "0.1.0",
  "minimum_chrome_version": "112",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["https://api.notion.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Guardar en mi biblioteca", "default_popup": "clip.html"},
  "options_page": "options.html"
}
